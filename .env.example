# Public website settings. Credentials never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Optional Umami analytics. Both values are public; leave unset to disable.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional: a public CDN origin. Leave unset for the default: R2 downloads at
# build time, served by this website under /media. No custom domain is needed.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com

# Content uploads and builds only. Credentials never reach the browser.
# Builds can use a separate read-only key; authoring tools need object read/write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
# Optional for another S3-compatible provider; defaults to the R2 account endpoint.
R2_ENDPOINT=

# One-time Contentful import only; not needed to build or serve the site.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_CONTENT_TYPE=hackyBlog
CONTENTFUL_LOCALE=en-US
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_MANAGEMENT_TOKEN=
